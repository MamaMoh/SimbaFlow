# SimbaFlow Environment Configuration
# Copy this file to .env and fill in values. NEVER commit .env to source control.

# Database
DB_PASSWORD=change_me_in_production

# JWT (minimum 32 bytes / 256 bits)
JWT_KEY=change_me_minimum_32_characters_long_secret_key_here

# NextAuth
NEXTAUTH_SECRET=change_me_random_secret_for_nextauth_sessions

# Docker image version tag
VERSION=1.0.0

# Bot Configuration (optional — leave empty to disable)
TELEGRAM_BOT_TOKEN=
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
