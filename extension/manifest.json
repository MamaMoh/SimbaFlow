{
  "manifest_version": 3,
  "name": "SimbaFlow Form Filler",
  "version": "0.5.0",
  "description": "Fills a candidate's details into the insurance and visa portals, from the record already held in SimbaFlow.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://app.laba.et/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://app.laba.et/*"
      ],
      "js": [
        "announce.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Fill from SimbaFlow",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
